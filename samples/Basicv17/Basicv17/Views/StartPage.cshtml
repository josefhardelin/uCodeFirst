@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<StartPage>
@{
    ViewBag.Title = Model.Headline ?? Model.Name;
}

<main>
    <h1>@Model.Headline</h1>

    @if (Model.Body is not null)
    {
        <div>@Model.Body</div>
    }

    @if (Model.ContentBlocks is not null)
    {
        @await Html.GetBlockListHtmlAsync(Model, "contentBlocks")
    }

    @if (Model.ContentGrid is not null)
    {
        @await Html.GetBlockGridHtmlAsync(Model, "contentGrid")
    }
</main>
