<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Josef Härdelin</Authors>
    <Description>Code-first schema authoring for Umbraco CMS 17+. Define document types as C#
      classes; the package syncs them into Umbraco on startup.</Description>
    <PackageTags>umbraco;code-first;schema;content-types;document-types</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.4.2, 18.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\uCodeFirst.Analyzers\uCodeFirst.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="uCodeFirst.Tests" />
  </ItemGroup>

</Project>